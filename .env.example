# Python MCP. Do not commit .env or real API keys.
# Use both on a VPS to expose /mcp plus legacy /sse. stdio remains available locally.
MCP_TRANSPORT=both
MCP_HOST=127.0.0.1
MCP_PORT=8000
BPS_API_KEY=
# STDIO only: separate SDGs Access token (remote users save it in their account).
BPS_SDGS_TOKEN=
BPS_DOMAIN=1100
SATU_DATA_ACEH_CATALOG_URL=https://satudata.acehprov.go.id/data.json
SATU_DATA_ACEH_CACHE_TTL=3600
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_ALLOWED_HOSTS=www.mcpsatudataaceh.web.id,mcpsatudataaceh.web.id
MCP_ALLOWED_ORIGINS=https://www.mcpsatudataaceh.web.id,https://mcpsatudataaceh.web.id,https://mcpplaygroundonline.com
LOG_LEVEL=INFO
BPS_DATASET_MAP={}
# Optional: override the bundled local catalog path.
# SATU_DATA_ACEH_LOCAL_PATH=/absolute/path/to/data.json

# Required for remote account mode. Generate ONCE and back up separately from DB:
# python3 -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ACCOUNTS_ENCRYPTION_KEY=
ACCOUNTS_DB_PATH=var/accounts.sqlite3
ACCOUNTS_PUBLIC_ORIGIN=https://www.mcpsatudataaceh.web.id
# CIMD metadata may only be fetched from these trusted HTTPS hosts. Others use DCR.
OAUTH_CIMD_HOSTS=chatgpt.com,claude.ai
ACCOUNTS_ALLOWED_ORIGINS=https://mcpsatudataaceh.web.id
# Only for a trusted Worker gateway; generate a separate secret of >=32 characters.
ACCOUNTS_SERVICE_SECRET=
# Development only, loopback bind required. Keep 0 in production.
ACCOUNTS_DEV_HTTP=0

# Email verification: Gmail SMTP with TLS. Set real values only in ignored .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=sender@example.com
SMTP_FROM=sender@example.com
SMTP_PASSWORD=
# Application send budget, not a statement of the provider's quota.
SMTP_DAILY_LIMIT=100
# Optional: keep the password in a private file instead of environment text.
# SMTP_PASSWORD_FILE=/run/secrets/gmail-app-password
