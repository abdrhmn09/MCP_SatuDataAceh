# Example env — copy to .env and fill values. Never commit secrets.

# MCP Transport: stdio (default) | sse | streamable-http
MCP_TRANSPORT=stdio

# Server Host & Port (hanya digunakan saat transport sse / streamable-http)
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Logging Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Rate Limiter (permintaan per menit)
MCP_RATE_LIMIT_PER_MINUTE=60

# Katalog Satu Data Aceh
SATU_DATA_ACEH_CATALOG_URL=https://satudata.acehprov.go.id/data.json
SATU_DATA_ACEH_CACHE_TTL=3600
SATU_DATA_ACEH_DATA_YEAR=2025

# Jalur katalog lokal sebagai fallback saat portal offline/gagal diakses
SATU_DATA_ACEH_LOCAL_PATH=data.json

# Integrasi Fallback BPS (Opsional)
# Dapatkan API key dari https://webapi.bps.go.id/
BPS_API_KEY=
BPS_DOMAIN=1100
# Format mapping identifier dataset ke variabel BPS (JSON string)
BPS_DATASET_MAP={"0116d97b-1b4a-4c6a-a243-33833660fb85":"621"}
